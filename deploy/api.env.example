# Copie para /etc/coffeeja/api.env (chmod 600, dono root). NUNCA versionar o arquivo real.
# Gere o segredo JWT com: openssl rand -base64 48
Jwt__Key=TROCAR-por-um-segredo-aleatorio-de-48-bytes
ConnectionStrings__Default=Server=localhost;Database=CoffeeJa;User Id=coffeeja_app;Password=TROCAR;TrustServerCertificate=True;Encrypt=True
Plataforma__UrlPublica=https://coffeeja.com.br
Plataforma__Origens__0=https://coffeeja.com.br
Plataforma__PastaArquivos=/var/coffeeja/storage
Plataforma__PastaChaves=/var/coffeeja/chaves
Plataforma__ProxiesConfiaveis__0=127.0.0.1
Plataforma__AprovarFornecedoresAutomaticamente=false
Plataforma__AdminEmail=admin@seu-dominio
Plataforma__AdminSenha=TROCAR-por-senha-forte-e-troque-no-primeiro-login
Banco__MigrarNaInicializacao=false
Banco__DadosDemo=false
# Web Push (opcional): gere o par VAPID uma vez
Push__PublicKey=
Push__PrivateKey=
Push__Subject=mailto:seguranca@seu-dominio
